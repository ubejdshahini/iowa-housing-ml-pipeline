# FastAPI authentication (choose your own long, random value)
API_KEY=replace-with-a-secure-api-key

# Databricks SQL Warehouse connection details
DATABRICKS_SERVER_HOSTNAME=adb-xxxxxxxxxxxxxxxx.x.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=replace-with-your-databricks-token

# Prediction table used by POST /save-predictions
DATABRICKS_TABLE=workspace.default.iowa_preditions
